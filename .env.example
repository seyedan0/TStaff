# Environment mode
NODE_ENV=development

# API Server
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3100

# Web Client
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=ws://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://tstaff_user:tstaff_pass@localhost:5432/tstaff_dev

# S3-Compatible Object Storage (Local / MinIO emulator or Iranian Provider)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tstaff-private-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# SMS Provider (Mock or Iranian Gateway)
SMS_PROVIDER=mock
SMS_API_KEY=mock-key
SMS_SENDER_NUMBER=10001234

# Security & Secrets
SESSION_SECRET=dev-insecure-secret-replace-in-production-min-32-chars
COOKIE_SECRET=dev-insecure-cookie-secret-replace-in-production

# Private-file scanning
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
FILE_MAX_BYTES=26214400

# Local workflow fixtures only. Keep real credentials out of source control.
DEFAULT_APPLICANT_PASSWORD=
# Configure these in apps/web/.env.local to show localhost-only quick login buttons.
VITE_LOCAL_TEST_LOGIN=false
VITE_LOCAL_TEST_PASSWORD=
VITE_LOCAL_TEST_USERS=[]

