{
  "name": "tstaff",
  "version": "0.1.0",
  "private": true,
  "description": "TStaff - Researcher Network and Scientific Workflow Management System",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" build",
    "lint": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" lint",
    "typecheck": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" typecheck",
    "test": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" test",
    "test:boundaries": "node scripts/check-boundaries.mjs",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}

